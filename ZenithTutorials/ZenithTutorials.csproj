<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
        <PackageReference Include="Zenith.NET.Extensions.ImageSharp" Version="1.0.0-rc" />
        <PackageReference Include="Zenith.NET.DirectX12" Version="1.0.0-rc" />
        <PackageReference Include="Zenith.NET.Metal" Version="1.0.0-rc" />
        <PackageReference Include="Zenith.NET.Vulkan" Version="1.0.0-rc" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets\Shaders\**\*;Assets\Textures\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
